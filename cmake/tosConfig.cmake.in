@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/TosCURL.cmake")
set(tos_FOUND TRUE)
unset(tos_NOT_FOUND_MESSAGE)
set(tos_base_FOUND TRUE)
include("${CMAKE_CURRENT_LIST_DIR}/tos-base-targets.cmake")

# Do not import unrequested targets: their static link interfaces can require external packages.
foreach(component IN LISTS tos_FIND_COMPONENTS)
    if(component STREQUAL "base")
        continue()
    endif()
    set(tos_${component}_FOUND FALSE)
    if(NOT component MATCHES "^(app|crypto|http)$")
        set(reason "Unknown tos component '${component}'")
    elseif(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/tos-${component}-targets.cmake")
        set(reason "tos component '${component}' was not installed")
    else()
        set(reason "")
        if(component STREQUAL "crypto")
            find_package(OpenSSL 3.0 QUIET COMPONENTS Crypto)
            if(NOT OpenSSL_FOUND)
                set(reason "tos crypto requires OpenSSL 3 Crypto development files")
            endif()
        elseif(component STREQUAL "http")
            tos_find_curl()
            if(NOT CURL_FOUND)
                set(reason "tos http requires libcurl development files (CURL::libcurl)")
            endif()
        endif()
        if(NOT reason)
            include("${CMAKE_CURRENT_LIST_DIR}/tos-${component}-targets.cmake")
            set(tos_${component}_FOUND TRUE)
        endif()
    endif()
    if(reason AND tos_FIND_REQUIRED_${component})
        string(APPEND tos_NOT_FOUND_MESSAGE "${reason}. ")
    endif()
endforeach()
check_required_components(tos)
